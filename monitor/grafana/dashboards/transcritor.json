    {
      "id": 10,
      "type": "bargauge",
      "title": "Espera média na fila por política",
      "description": "Tempo entre chegar e um worker pegar o job. Compare FIFO e SJF",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 14,
        "w": 6,
        "h": 8
