            "lineWidth": 2,
            "fillOpacity": 18,
            "gradientMode": "opacity",
            "showPoints": "never",
            "lineInterpolation": "stepAfter",
            "spanNulls": true
          },
          "min": 0
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Na fila"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#5b6172"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Dentro do motor"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#c94a4a"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Vagas do semáforo"
