    {
      "id": 7,
      "type": "state-timeline",
      "title": "O que cada worker está fazendo · verde livre · azul ffmpeg · amarelo esperando o motor · vermelho transcrevendo",
      "description": "Cada linha é um processo worker. Vermelho = dentro do motor (seção crítica protegida pelo semáforo)",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 16,
        "h": 10
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "max by (worker) (transcritor_worker_estado)",
          "legendFormat": "{{worker}}",
          "refId": "A",
          "range": true,
          "instant": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "#8e8e8e",
                "value": null
              },
              {
                "color": "#2f9e6e",
                "value": 0.5
              },
              {
                "color": "#3c6fd8",
                "value": 1.5
              },
              {
                "color": "#f2a541",
                "value": 2.5
              },
              {
                "color": "#c94a4a",
                "value": 3.5
              }
            ]
          },
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "Iniciando",
                  "index": 0
                },
                "1": {
                  "text": "Livre",
                  "index": 1
                },
                "2": {
                  "text": "Convertendo (ffmpeg)",
                  "index": 2
                },
                "3": {
                  "text": "Esperando o motor",
                  "index": 3
                },
                "4": {
                  "text": "Transcrevendo",
                  "index": 4
                }
              }
            }
          ],
          "custom": {
            "fillOpacity": 85,
            "lineWidth": 0
          }
        },
        "overrides": []
      },
      "options": {
        "showValue": "never",
        "mergeValues": true,
        "alignValue": "left",
        "rowHeight": 0.8,
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": false
        },
        "tooltip": {
          "mode": "single",
          "sort": "none"
        }
      }
    },
    {
      "id": 8,
      "type": "table",
      "title": "Workers agora",
      "description": "Processos vivos: PID dado pelo sistema operacional, estado e job atual",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 16,
        "y": 4,
        "w": 8,
        "h": 10
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "max by (worker, pid, estado, trabalho) (transcritor_worker_info)",
          "legendFormat": "",
          "refId": "A",
          "range": false,
          "instant": true,
          "format": "table"
        }
      ],
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "Value": true
            },
            "indexByName": {
              "worker": 0,
              "pid": 1,
              "estado": 2,
              "trabalho": 3
            },
            "renameByName": {
              "worker": "Worker",
              "pid": "PID",
              "estado": "Estado",
              "trabalho": "Job"
            }
          }
        },
        {
          "id": "sortBy",
          "options": {
            "sort": [
              {
                "field": "Worker"
              }
            ]
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "left"
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Estado"
            },
            "properties": [
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-text"
                }
              },
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "livre": {
                        "color": "#2f9e6e",
                        "index": 0
                      },
                      "convertendo": {
                        "color": "#3c6fd8",
                        "index": 1
                      },
                      "esperando": {
                        "text": "esperando o motor",
                        "color": "#f2a541",
                        "index": 2
                      },
                      "transcrevendo": {
                        "color": "#c94a4a",
                        "index": 3
                      }
                    }
                  }
                ]
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "cellHeight": "md"
      }
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "Fila e motor",
      "description": "O semáforo limita quantos workers usam o motor (GPU ou CPU) ao mesmo tempo",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 14,
        "w": 12,
        "h": 8
