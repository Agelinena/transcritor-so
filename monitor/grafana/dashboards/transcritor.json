          "legendFormat": "{{politica}}",
          "refId": "A",
          "range": false,
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "decimals": 1,
          "noValue": "aguardando jobs",
          "min": 0,
          "color": {
            "mode": "fixed",
            "fixedColor": "#f2a541"
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
