                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#c94a4a"
                }
              }
            ]
          }
        ]
      },
      "options": {
        "orientation": "horizontal",
        "displayMode": "gradient",
        "showUnfilled": true,
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "valueMode": "color",
        "namePlacement": "top",
        "sizing": "manual",
        "minVizHeight": 28,
        "maxVizHeight": 44
      }
